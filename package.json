{
  "name": "cloudflare-manager",
  "version": "0.3.1",
  "description": "Cloudflare 多账户管理系统",
  "main": "index.js",
  "scripts": {
    "tauri": "tauri",
    "dev": "npm run build:css && tauri dev",
    "build": "npm run build:css && tauri build",
    "build:css": "npx tailwindcss -i ./src/input.css -o ./src/tailwind.css --minify",
    "watch:css": "npx tailwindcss -i ./src/input.css -o ./src/tailwind.css --watch",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": ["cloudflare", "manager", "tauri"],
